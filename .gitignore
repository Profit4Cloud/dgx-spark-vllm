# Environment files anywhere in the repository
.env
.env.*
!.env.example

# Local overrides and secrets
*.local.yaml
*.local.yml
*.local.json
*.key
*.pem

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Registered targets and copied profile dashboards are runtime state.
/observability/targets/*
!/observability/targets/.gitkeep
/observability/grafana/dashboards/profiles/*
!/observability/grafana/dashboards/profiles/.gitkeep
